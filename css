*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Poppins",sans-serif;
}

body{
    background:#0f172a;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.container{
    width:700px;
    background:#1e293b;
    border-radius:15px;
    padding:30px;
    box-shadow:0 0 20px rgba(0,255,255,.3);
}

h1{
    color:#38bdf8;
    text-align:center;
    margin-bottom:25px;
}

.chat-box{
    height:350px;
    overflow-y:auto;
    background:#111827;
    border-radius:10px;
    padding:20px;
    margin-bottom:20px;
    color:white;
}

.user{
    text-align:right;
    margin:10px 0;
}

.assistant{
    text-align:left;
    margin:10px 0;
    color:#38bdf8;
}

.input-area{
    display:flex;
    gap:10px;
}

input{
    flex:1;
    padding:15px;
    border:none;
    border-radius:8px;
    outline:none;
    font-size:16px;
}

button{
    padding:15px 20px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
    background:#0ea5e9;
    color:white;
    transition:.3s;
}

button:hover{
    background:#0284c7;
}

#mic{
    background:#10b981;
}

#mic:hover{
    background:#059669;
}

.footer{
    margin-top:20px;
    text-align:center;
    color:#94a3b8;
    font-size:14px;
}
